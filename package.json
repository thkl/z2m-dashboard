{
  "name": "zigbee2mqtt-dashboard",
  "version": "0.0.0",
  "main": "./index.js",
  "scripts": {
    "ng": "ng",
    "sec": "pnpm outdated",
    "start": "ng serve",
    "security-scan": "semgrep scan --config auto .",
    "build-page": "npm run increment-version && ng build  --base-href /z2m-dashboard/;npx angular-cli-ghpages --dir=dist --repo=https://github.com/thkl/z2m-dashboard.git",
    "increment-version": "node scripts/increment-version.js",
    "build": "npm run increment-version && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "packageManager": "pnpm@10.10.0",
  "prettier": {
    "printWidth": 180,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": false,
  "dependencies": {
    "@angular/cdk": "21.2.8",
    "@angular/common": "21.2.8",
    "@angular/compiler": "21.2.8",
    "@angular/core": "21.2.8",
    "@angular/forms": "21.2.8",
    "@angular/platform-browser": "21.2.8",
    "@angular/router": "21.2.8",
    "@ngrx/signals": "21.1.0",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "d3": "^7.9.0",
    "ngx-logger": "5.0.12",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@angular/build": "21.2.8",
    "@angular/cli": "21.2.8",
    "@angular/compiler-cli": "21.2.8",
    "@angular/platform-browser-dynamic": "21.2.8",
    "@types/d3": "^7.4.3",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "autoprefixer": "^10.4.27",
    "jsdom": "^27.2.0",
    "postcss": "8.5.10",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.18",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}